OCR_REPLICAS=2
OCR_IMAGE=ghcr.io/chbister/com.mybister.ocr:latest
TEMP_MAX_AGE_HOURS=24
CALLBACK_TIMEOUT_MS=30000
# Target systems: shared docker network must already exist (default: true).
# Local dev without proxy-network: set to false, compose creates a
# project-local network automatically.
PROXY_NETWORK_EXTERNAL=true
